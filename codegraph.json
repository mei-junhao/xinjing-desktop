{
  "$comment": "CodeGraph index scope for XinJing. Keeps the graph on PRODUCT SOURCE only; qa/ (35.5GB evidence/scratch) and docs/ (25.6GB coordination dumps) plus per-version build outputs are excluded because they are archives, not code.",
  "exclude": [
    "qa/",
    "docs/",
    "xj5*-build-out/",
    "dist/",
    "output/",
    "external-run/",
    "cos-assets/",
    "design-previews/",
    "evidence/",
    "scratch/",
    "tmp/",
    "Temp/",
    "_tmp*/",
    "_tmp*",
    "_exam_grading_tmp/",
    "_scan_tmp_no/",
    "_bc.js",
    "**/_*.cjs",
    "**/_*.js",
    ".ss-test-tmp*/",
    "**/*.test.cjs",
    ".builder-cache/",
    ".electron-cache/",
    ".npm-cache/",
    ".codex/",
    ".codex-quarantine/",
    ".qoder/",
    ".playwright-cli/",
    ".wrangler/",
    "node_modules/",
    "**/node_modules/",
    "xinjing-tauri/src-tauri/target/",
    "**/*.log",
    "**/*.jsonl",
    "**/*.old",
    "**/*.bak",
    "**/*.bak-*",
    "**/*.tmp",
    "**/*.map",
    "**/*.png",
    "**/*.jpg",
    "**/*.jpeg",
    "**/*.gif",
    "**/*.webp",
    "**/*.ico",
    "**/*.pak",
    "**/*.bin",
    "**/*.dll",
    "**/*.exe",
    "**/*.asar",
    "**/*.zip",
    "**/*.7z",
    "**/*.dmg",
    "**/*.baj",
    "**/*.baf",
    "**/*.nsh"
  ],
  "include": [
    "app/**",
    "main.js",
    "preload.js",
    "confirm-close-preload.js",
    "_bc.js",
    "server/**",
    "scripts/**",
    "tests/**",
    "tools/**",
    "android/app/src/**",
    "xinjing-tauri/src/**"
  ]
}
